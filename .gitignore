# Quarto
/.quarto/
/_freeze/

# Knitr intermediates at the PROJECT ROOT only.
# The leading slash matters: a bare "*_files/" would also match
# docs/01-getting-started_files/, which holds the rendered figures.
# Ignoring those is what produces broken image icons on the published site.
/*_files/
/*_cache/

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# macOS
.DS_Store

# LaTeX intermediates
*.log
*.aux
*.tex

# NOTE: the docs/ folder is intentionally NOT ignored.
# GitHub Pages serves the site from there, so the rendered
# output must be committed.
.positai
